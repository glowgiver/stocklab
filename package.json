{
  "name": "stocklab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_BACKEND=local VITE_LOCAL_SEED=1 vite build --outDir dist-local && vite preview --outDir dist-local --port 5180 --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "settle": "node --experimental-strip-types scripts/settle.ts",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "typecheck": "tsc --noEmit",
    "dev:local:hot": "VITE_BACKEND=local VITE_LOCAL_SEED=1 vite"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}